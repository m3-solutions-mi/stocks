# This is a comment
# Blank lines are ignored for readability

# Ignore all files ending in .log at any level
#*.log

# Ignore a specific file named "secrets.txt" in the root directory
#/secrets.txt

# Ignore the entire "node_modules" directory and everything inside it
#node_modules/

